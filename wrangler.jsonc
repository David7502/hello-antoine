{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hello-antoine",
  // Today's date so the Worker picks up the current Workers runtime.
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // Static site only: no Worker script. Requests are served from ./public.
  "assets": {
    "directory": "./public"
  }
}
